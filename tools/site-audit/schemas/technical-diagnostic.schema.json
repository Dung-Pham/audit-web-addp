{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["finding_id", "observed_problem", "confirmed_external_facts", "probable_technical_causes", "developer_investigation", "implementation_area", "confidence"],
  "properties": {
    "finding_id": {"type": "string", "pattern": "^FND-"},
    "observed_problem": {"type": "string", "minLength": 1},
    "confirmed_external_facts": {"type": "array", "items": {"type": "string"}},
    "probable_technical_causes": {"type": "array", "items": {"type": "string"}},
    "developer_investigation": {"type": "array", "items": {"type": "string"}},
    "implementation_area": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": true
}
