{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["task_id", "finding_ids", "title", "objective", "current_problem", "target_state", "recommended_changes", "affected_urls", "implementation_area", "developer_investigation", "dependencies", "priority", "effort", "acceptance_criteria", "automated_verification", "manual_verification", "risks", "status"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^TASK-[A-Za-z0-9._-]+$"},
    "finding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FND-"}},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "current_problem": {"type": "string", "minLength": 1},
    "target_state": {"type": "string", "minLength": 1},
    "recommended_changes": {"type": "array", "items": {"type": "string"}},
    "affected_urls": {"type": "array", "items": {"type": "string"}},
    "implementation_area": {"type": "array", "items": {"type": "string"}},
    "developer_investigation": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^TASK-"}},
    "priority": {"enum": ["P0", "P1", "P2", "P3"]},
    "effort": {"enum": ["S", "M", "L", "XL"]},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "automated_verification": {"type": "array", "items": {"type": "string"}},
    "manual_verification": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "status": {"const": "planned"}
  },
  "additionalProperties": true
}
